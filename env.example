# ── Copy to .env and fill in ────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# PostgreSQL connection string
DATABASE_URL=postgresql://gamehub:gamehub@localhost:5432/gamehub?schema=public

# REQUIRED in production, 32+ random chars:  openssl rand -base64 48
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_EXPIRES_IN=7d

# Browser origins allowed to call the API (comma-separated). Only needed when the
# client is hosted on a different origin than the server (e.g. Vercel + Render).
CLIENT_ORIGIN=http://localhost:5173

# Optional: enables POST /api/games (register external games), sent as x-admin-key
ADMIN_KEY=

# Optional tuning
AUTO_SEED=true          # upsert the built-in game catalogue on boot
AUTH_RATE_LIMIT=60      # auth requests / 15 min / IP
SCORE_RATE_LIMIT=60     # score requests / min / IP
MATCH_GRACE_MS=10000    # reconnect window before a disconnected player forfeits

# Client build-time only (split deployments): public URL of the server
# VITE_API_URL=https://game-hub-api.onrender.com
