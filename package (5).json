{
  "name": "game-hub",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Arcade-style Game Hub: React + Tailwind client, Express + Socket.io + Prisma/PostgreSQL server",
  "workspaces": [
    "server",
    "client"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n server,client -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "db:migrate": "npm run db:migrate -w server",
    "db:deploy": "npm run db:deploy -w server",
    "db:seed": "npm run db:seed -w server",
    "test": "npm test -w server"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
